{
  "name": "ws-unapi-relay",
  "version": "0.1.0",
  "description": "Restricted WebSocket relay for TCP/IP UNAPI clients",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvogendut/ws-unapi-relay.git"
  },
  "bugs": {
    "url": "https://github.com/salvogendut/ws-unapi-relay/issues"
  },
  "homepage": "https://github.com/salvogendut/ws-unapi-relay#readme",
  "main": "src/relay.js",
  "bin": {
    "ws-unapi-relay": "bin/ws-unapi-relay.js"
  },
  "files": [
    "bin/",
    "docs/",
    "packaging/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/config.js && node --check src/protocol.js && node --check src/relay.js && node --check bin/ws-unapi-relay.js",
    "start": "node bin/ws-unapi-relay.js",
    "test": "node --test test/*.test.js",
    "test:all": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
