# The standalone relay listens only on loopback by default. A reverse proxy can
# publish /unapi over WSS without exposing this port directly.
UNAPI_RELAY_HOST=127.0.0.1
UNAPI_RELAY_PORT=1983
UNAPI_RELAY_PATH=/unapi

# Set the exact public origin(s) of the 1983 browser application.
# UNAPI_ORIGINS=https://1983.example.org

# For public deployments, add a random secret and keep this file mode 0600.
# UNAPI_TOKEN=replace-with-a-long-random-value

# Keep these destination allowlists as narrow as guest software permits.
UNAPI_TCP_PORTS=23,70,80,443,2323
UNAPI_UDP_PORTS=123

# Private, loopback, link-local, reserved, and documentation destinations are
# denied by default. Do not enable this on a public relay.
UNAPI_ALLOW_PRIVATE=false
UNAPI_ALLOW_MISSING_ORIGIN=false
